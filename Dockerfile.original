# Build Stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies including Rust
RUN apk add --no-cache make git gcc musl-dev linux-headers curl

# Install Rust for building REVM
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy dependency files first (better caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the REVM library from source
WORKDIR /app/revm_wrapper
RUN cargo build --release

# Copy the built library to the expected location
RUN mkdir -p /app/lib && \
    cp target/release/libthrylos_revm.so /app/lib/ || \
    cp target/release/libthrylos_revm.dylib /app/lib/libthrylos_revm.so || \
    cp target/release/libthrylos_revm.a /app/lib/

# Build the Go binaries
WORKDIR /app
RUN go build -o /app/bin/thrylos ./cmd/thrylos
RUN go build -o /app/bin/gen-genesis ./cmd/genesis-generator

# Runner Stage
FROM alpine:latest

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache curl bash libgcc

# Copy binaries from builder
COPY --from=builder /app/bin/thrylos /usr/local/bin/thrylos
COPY --from=builder /app/bin/gen-genesis /usr/local/bin/gen-genesis

# Copy the REVM library
COPY --from=builder /app/lib/libthrylos_revm.so /usr/local/lib/
RUN ldconfig /usr/local/lib || true

# Copy entrypoint script
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Create data directories
RUN mkdir -p /app/data /app/config /app/keys

# Expose ports (P2P, API)
EXPOSE 9000 8080

ENTRYPOINT ["/app/entrypoint.sh"]